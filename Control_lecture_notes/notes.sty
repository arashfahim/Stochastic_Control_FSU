%  notes.sty — General settings for lecture notes
%  Cleaned up for PDF/UA-1 accessibility (ADA compliance) via the LaTeX tagging
%  project, and trimmed to only the packages and macros this document uses.
%
%  Changes from the original, and why:
%
%   * amsthm is NOT loaded.  It is the root cause of the "there is no open
%     structure on the stack" errors: its theorem machinery is not tagging-aware
%     in TeX Live 2023 and breaks the tag stack in every theorem-like
%     environment.  LaTeX's own kernel \newtheorem handles all nine environments
%     correctly under tagging, so the environments below are declared with that
%     instead, and \begin{proof} is reimplemented in a few lines.
%
%   * ulem is NOT loaded.  The document uses none of its commands (\uline,
%     \sout, \xout, \uuline), and it redefines \emph to underline, which
%     collided with the tagging layer.  If you ever need it, load it as
%     \usepackage[normalem]{ulem} so \emph stays italic.
%
%   * hyperref and cleveref are NOT loaded here.  hyperref belongs in the main
%     document after \DocumentMetadata; cleveref must follow hyperref and the
%     document uses none of its commands (\cref, \Cref), so it was dropped.
%
%   * \tocandfigures rewritten.  The original nested \tableofcontents and
%     \newpage inside three flushleft environments, whose groups broke the tag
%     stack.  They served no typographic purpose and are gone.
%
%   * microtype uses expansion=false.  Auto font expansion needs scalable fonts,
%     which the default Computer Modern set does not provide; protrusion still
%     works.
%
%   * Removed packages the document never uses: mathrsfs, makeidx, setspace,
%     listings, thmtools, appendix, tikz, pgfplots, latexsym, nameref, epsfig,
%     dsfont, times.
%
%   * Removed roughly 170 unused macros (calligraphic, bar/hat/tilde/check
%     decorators, display-math operator shortcuts, article-specific shortcuts)
%     and \def\R (the document writes \mathbb{R} explicitly).
%
%   * Removed duplicate \usepackage calls: graphicx x3, amsmath x3, amsthm x2,
%     fontenc x3, caption x2, hyperref x2, tikz x2, url x2, float x2.

% -----------------------------------------------------------------------
%  Fonts & encoding
% -----------------------------------------------------------------------
\usepackage{iftex}
% T1 is a pdfLaTeX encoding.  Under LuaLaTeX the default Unicode (TU) encoding
% gives real Unicode text in the PDF, which is what screen readers need.
\ifLuaTeX\else
  \usepackage[T1]{fontenc}
\fi
\usepackage[expansion=false]{microtype}

% -----------------------------------------------------------------------
%  Math  (amsthm deliberately omitted — see header)
% -----------------------------------------------------------------------
\usepackage{amsmath}
\usepackage{mathtools}
% LuaLaTeX: unicode-math (OpenType Latin Modern Math) lets the tagging layer
% produce MathML for screen readers instead of only LaTeX-source alt text.
% It provides every amssymb/amsfonts symbol and clashes with those packages,
% so they are loaded only for pdfLaTeX.
\ifLuaTeX
  % warnings-off: the notes use none of mathtools' colon or bracket commands,
  % so unicode-math's notices about overriding them are irrelevant.
  \usepackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
  \setmathfont{Latin Modern Math}
\else
  \usepackage{amssymb,amsfonts}
\fi

% -----------------------------------------------------------------------
%  Graphics, floats, tables
% -----------------------------------------------------------------------
\usepackage{graphicx}
\usepackage{float}
\usepackage{caption}
\usepackage{tabularx}
\usepackage{enumerate}

% -----------------------------------------------------------------------
%  Misc
% -----------------------------------------------------------------------
\usepackage{geometry}
\usepackage{fancyhdr}
\usepackage{url}
% xcolor rather than color: the document uses \color{orange}, which the basic
% color package does not define.
\usepackage[dvipsnames]{xcolor}
\usepackage{comment}

% -----------------------------------------------------------------------
%  Page layout
% -----------------------------------------------------------------------
% headheight: the running head is two lines tall (fancyhdr asked for 25.2pt).
% marginparwidth: the default 116pt overran the 1in margin; no \marginpar is used.
\geometry{verbose,letterpaper,tmargin=1.0in,bmargin=1.0in,lmargin=1in,rmargin=1in,
  headheight=26pt,marginparwidth=0.6in}
\pagestyle{fancy}
\renewcommand{\baselinestretch}{1}
\setlength\parindent{5pt}
\renewcommand{\ps@plain}{\pagestyle{fancy}}
\captionsetup{labelfont=bf,indention=0cm}
% Last-resort extra interword stretch for paragraphs that would otherwise run
% into the margin (long inline math). Other paragraphs are unaffected.
\setlength{\emergencystretch}{2em}

% -----------------------------------------------------------------------
%  Numbering
% -----------------------------------------------------------------------
\numberwithin{equation}{section}
\numberwithin{figure}{section}

% -----------------------------------------------------------------------
%  Tagging helpers
%  If the tagging layer is not loaded (compiling without \DocumentMetadata),
%  these become silent no-ops so the file still builds.
% -----------------------------------------------------------------------
%  LaTeX 2024-06 and later (TeX Live 2024+) provide \SuspendTagging /
%  \ResumeTagging, the documented interface, which keeps the paragraph counters
%  balanced.  Older releases fall back to tagpdf's \tag_stop: / \tag_start:.
%  Without the tagging layer both become no-ops.
\ExplSyntaxOn
\cs_if_exist:NTF \SuspendTagging
  {
    \NewDocumentCommand \TagSuspend {} { \SuspendTagging{notes} }
    \NewDocumentCommand \TagResume  {} { \ResumeTagging{notes} }
  }
  {
    \cs_if_exist:NTF \tag_stop:
      {
        \NewDocumentCommand \TagSuspend {} { \tag_stop: }
        \NewDocumentCommand \TagResume  {} { \tag_start: }
      }
      {
        \NewDocumentCommand \TagSuspend {} { }
        \NewDocumentCommand \TagResume  {} { }
      }
  }
\ExplSyntaxOff

% -----------------------------------------------------------------------
%  Theorem-like environments
%  Declared with LaTeX's kernel \newtheorem, which is tagging-safe.
%  Only the environments this document uses are defined.
% -----------------------------------------------------------------------
\newtheorem{defn}{Definition}[section]
\newtheorem{rem}{Remark}[section]
\newtheorem{thm}{Theorem}[section]
\newtheorem{lem}{Lemma}[section]
\newtheorem{coro}{Corollary}[section]
\newtheorem{assp}{Assumption}
\newtheorem{eg}{Example}
\newtheorem{ex}{Exercise}

% -----------------------------------------------------------------------
%  proof environment
%  Replaces amsthm's version (see header).  Built from plain paragraph
%  material so the tagging layer stays balanced.
% -----------------------------------------------------------------------
\providecommand{\proofname}{Proof}
\providecommand{\qedsymbol}{\ensuremath{\square}}
% Guarded: newer LaTeX releases (and amsthm) already provide a `proof`
% environment, and on TeX Live 2024+ theirs is tagging-aware.  Defer to it when
% present; define our own only when it is missing.
\makeatletter
\@ifundefined{proof}{%
  \newenvironment{proof}[1][\proofname]{%
    \par\addvspace{\topsep}%
    \noindent\textit{#1.}\enspace\ignorespaces
  }{%
    \unskip\nobreak\hfill\qedsymbol
    \par\addvspace{\topsep}%
  }%
}{}%
\makeatother

% -----------------------------------------------------------------------
%  \tocandfigures — front-matter rule, timestamp and table of contents
%  Rewritten; see header for why the flushleft wrappers were removed.
% -----------------------------------------------------------------------
\newcommand{\tocandfigures}{%
  \par\TagSuspend % \par first: never suspend inside an open paragraph
  \noindent
  \rule[0.5ex]{1\columnwidth}{1pt}\par
  \noindent Last Revision: \today\par
  \setcounter{page}{1}%
  \setcounter{secnumdepth}{0}% hide section numbers in header
  \tableofcontents
  \par\noindent
  \rule[0.5ex]{1\columnwidth}{1pt}\par
  \TagResume
  \newpage
}

% -----------------------------------------------------------------------
%  Macros used by this document
% -----------------------------------------------------------------------
\newcommand{\noun}[1]{\textsc{#1}}        % small caps, used on the title page
\newcommand{\Cn}[1]{{\rm C}^{#1}}         % C^k function spaces
\def\USC{{\rm USC}}                       % upper semicontinuous
\def\LSC{{\rm LSC}}                       % lower semicontinuous
\def\eps{\varepsilon}
\def\x{\times}
\def\1{{\mathbf{1}}}                      % indicator; \mathds needs dsfont, unavailable
\DeclareMathOperator*{\argmin}{arg\,min}
