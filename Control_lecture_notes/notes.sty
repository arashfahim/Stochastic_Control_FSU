% notes.sty -- reconstructed support package for "Methods of Optimal Control"
% The original notes.sty was not available; this file provides every command
% and environment the document uses, chosen to be compatible with PDF tagging
% (\DocumentMetadata / latex-lab testphase code).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}[2026/06/11 reconstructed notes package, tagging-friendly]

\RequirePackage{xcolor}
\RequirePackage{tabularx}
\RequirePackage{fancyhdr}
\RequirePackage{amsmath,amssymb}

% ---- page style (document uses \chead, \lhead) ----
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% ---- small caps helper used on the title page ----
\newcommand{\noun}[1]{\textsc{#1}}

% ---- front matter helper ----
\newcommand{\tocandfigures}{%
  \tableofcontents
  \listoffigures
  \newpage
}

% ---- sectioning alias used in the source ----
\newcommand{\ssection}[1]{\section{#1}}

% ---- math shorthands ----
\newcommand{\R}{\mathbb{R}}
\newcommand{\eps}{\varepsilon}
\newcommand{\USC}{\operatorname{USC}}
\newcommand{\LSC}{\operatorname{LSC}}
\newcommand{\Cn}[1]{\mathrm{C}^{#1}}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

% ---- theorem-like environments ----
% Implemented as plain paragraph-based environments (not amsthm) because the
% amsthm trivlist machinery is incompatible with the PDF tagging code in this
% TeX Live release. Visual style is close to amsthm's plain/definition/remark.
\newcounter{thm}[chapter]
\renewcommand{\thethm}{\thechapter.\arabic{thm}}

\NewDocumentCommand\notes@thmhead{mm}{%
  \par\addvspace{.5\baselineskip}%
  \refstepcounter{thm}%
  \noindent\textbf{#1 \thethm}\IfValueT{#2}{}% placeholder
}
% style: italic body (plain)
\NewDocumentCommand\notes@newthm{mmm}{%
  \NewDocumentEnvironment{#1}{o}{%
    \par\addvspace{.5\baselineskip}%
    \refstepcounter{thm}%
    \noindent\textbf{#2~\thethm}\IfValueT{##1}{ \textbf{(##1)}}\textbf{.}~#3%
  }{\par\addvspace{.5\baselineskip}}%
}
\makeatletter
\notes@newthm{thm}{Theorem}{\itshape}
\notes@newthm{lem}{Lemma}{\itshape}
\notes@newthm{coro}{Corollary}{\itshape}
\notes@newthm{prop}{Proposition}{\itshape}
\notes@newthm{defn}{Definition}{}
\notes@newthm{eg}{Example}{}
\notes@newthm{ex}{Exercise}{}
\notes@newthm{assp}{Assumption}{}
\notes@newthm{rem}{Remark}{}
\makeatother

% proof environment (amsthm-free)
\NewDocumentEnvironment{proof}{o}{%
  \par\addvspace{.5\baselineskip}%
  \noindent\textit{\IfValueTF{#1}{#1}{Proof}.}~%
}{\nobreak\hfill\ensuremath{\square}\par\addvspace{.5\baselineskip}}

\endinput
